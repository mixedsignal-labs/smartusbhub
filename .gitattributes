# 统一处理所有文本文件的行尾符
# 在 Windows 上检出时转换为 CRLF，提交时转换为 LF
* text=auto eol=lf

# 明确指定某些文件类型使用 LF
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.whl binary
*.tar.gz binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

